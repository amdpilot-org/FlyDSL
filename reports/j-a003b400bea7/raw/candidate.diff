 def bscale_bytes_for(ne, n, k):
     return ne * kbs_per_expert_dw_for(n, k) * 4
 
 
 def kmchunks_for(BM):
     return BM // 16
 
 
 def lds_acc_bytes_for(rows, BN):
     return rows * BN * 4
